<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_dirt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOREX"
            android:textColor="@color/mc_gold"
            android:textSize="34sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="3" android:shadowDy="3" android:shadowRadius="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLIENT v3"
            android:textColor="@color/mc_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="checking..."
            android:textColor="@color/mc_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:background="@drawable/mc_panel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Setup"
            android:textColor="@color/mc_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. Grant Overlay"
            android:background="@drawable/mc_button"
            android:textColor="@color/mc_text"
            android:textStyle="bold"
            android:padding="14dp" />

        <Button
            android:id="@+id/btn_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Grant Usage Access"
            android:background="@drawable/mc_button"
            android:textColor="@color/mc_text"
            android:textStyle="bold"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Runtime"
            android:textColor="@color/mc_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start Dorex"
            android:background="@drawable/mc_button"
            android:textColor="@color/mc_text"
            android:textStyle="bold"
            android:padding="14dp" />

        <Button
            android:id="@+id/btn_launch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Launch Minecraft"
            android:background="@drawable/mc_button"
            android:textColor="@color/mc_text"
            android:textStyle="bold"
            android:padding="14dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop Dorex"
            android:background="@drawable/mc_button"
            android:textColor="@color/mc_text"
            android:textStyle="bold"
            android:padding="14dp" />
    </LinearLayout>
</ScrollView>